import Button from "./button.design"

<Frame name="Checkout" width={390} height={844} fill="#f8fafc"
       layout="column" gap={16} padding={24}>
  <Text size={28} weight={700}>Your cart</Text>
  <Frame width="fill" layout="row" justify="space-between" align="center"
         padding={16} radius={12} fill="#ffffff" stroke="#e2e8f0">
    <Frame layout="column" gap={4}>
      <Text size={16} weight={500}>Linen shirt</Text>
      <Text size={14} color="#64748b">Size M · Sand</Text>
    </Frame>
    <Text size={16} weight={600}>$42</Text>
  </Frame>
  <Frame height="fill" />
  <Button label="Pay $42" width="fill" onClick="navigate ./confirmation.design" />
</Frame>
