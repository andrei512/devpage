import Button from "./button.design"

<Frame name="Confirmation" width={390} height={844} fill="#f8fafc"
       layout="column" gap={16} padding={24} align="center" justify="center">
  <Ellipse width={72} height={72} fill="#16a34a" />
  <Text size={24} weight={700}>Order placed</Text>
  <Text size={16} color="#64748b">We'll email you when it ships.</Text>
  <Button label="Back to cart" fill="#0f172a" onClick="back" />
</Frame>
