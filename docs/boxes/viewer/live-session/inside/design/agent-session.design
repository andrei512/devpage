    </Frame>
    <Frame height={28} />
    <Text size={22} weight={700} color={theme.text}>Signing in</Text>
    <Frame height={10} />
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>The first account you make is the owner.</Text>
    </Frame>
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>A forgotten password is reset from the sign-in page, by email.</Text>
    </Frame>
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>The form works on a phone.</Text>
    </Frame>
    <Frame height={28} />
    <Text size={22} weight={700} color={theme.text}>Where things are</Text>
    <Frame height={10} />
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>Pages are in one folder, one file per page.</Text>
    </Frame>
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>Each feature keeps its code and its tests together.</Text>
    </Frame>
  </Frame>

