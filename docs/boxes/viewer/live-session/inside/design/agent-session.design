  <Frame x={264} y={76} layout="column" width={580}>
    <Text size={30} weight={700} color={theme.text}>Getting started</Text>
    <Frame height={10} />
    <Text size={14} color={theme.text} width={580} lineHeight={1.55}>How to run the project on your machine, and where to look first.</Text>
    <Frame height={28} />
    <Text size={22} weight={700} color={theme.text}>Run it</Text>
    <Frame height={10} />
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>Install the dependencies.</Text>
    </Frame>
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
      <Text size={14} color={theme.text} width={540} lineHeight={1.55}>Copy the example settings and fill in your own values.</Text>
    </Frame>
    <Frame layout="row" gap={10} padding={[3, 6]}>
      <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
