  <Rect x={240} y={52} width={1} height={812} fill={theme.border} />
  <Frame x={264} y={80} layout="column" width={672}>
      <Text size={30} weight={700} color={theme.text}>The waiting list</Text>
      <Frame height={10} />
      <Text size={14} color={theme.text} width={660} lineHeight={1.55}>Every garden has more people who want a plot than plots. The waiting list decides who is offered the next one.</Text>
      <Frame height={28} />
      <Text size={22} weight={700} color={theme.text}>How a plot is offered</Text>
      <Frame height={12} />
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>A gardener joins the list of one garden, or of every garden in the town.</Text>
      </Frame>
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>When a plot is given up, it is offered to the first person on the list.</Text>
      </Frame>
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>An offer stays open for a while, then goes to the next person.</Text>
      </Frame>
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>A coordinator can skip the list for a school or a community group.</Text>
      </Frame>
      <Frame height={32} />
      <Text size={22} weight={700} color={theme.text}>What a gardener sees</Text>
      <Frame height={12} />
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>Their place on the list, for each garden.</Text>
      </Frame>
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>An email when a plot is offered, with one button to accept.</Text>
      </Frame>
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>The offers they let pass.</Text>
      </Frame>
      <Frame height={32} />
      <Text size={22} weight={700} color={theme.text}>What a coordinator sees</Text>
      <Frame height={12} />
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>The list of their garden, in order, with the date each person joined.</Text>
      </Frame>
      <Frame layout="row" gap={10} padding={[3, 6]} radius={3}>
        <Text size={14} color={theme.text} lineHeight={1.55}>•</Text>
        <Text size={14} color={theme.text} width={630} lineHeight={1.55}>Which plot is on offer, and to whom.</Text>
      </Frame>
  </Frame>
